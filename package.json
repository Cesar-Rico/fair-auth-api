{
  "name": "fair-auth-lib",
  "version": "1.0.4",
  "description": "Librería de autenticación plug-and-play para Node.js con soporte de JWT y validaciones",
  "main": "dist/index.js",
  "author": "Fair Auth Team",
  "types": "dist/index.d.ts",
  "licence": "ISC",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "typescript",
    "library",
    "plug-and-play"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "argon2-browser": "^1.18.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "scrypt-js": "^3.0.1",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@types/argon2-browser": "^1.18.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "type": "module"
}
